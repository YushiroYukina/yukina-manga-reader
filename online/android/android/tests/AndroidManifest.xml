    </application>
    <instrumentation android:name="cn.migi.reader.NativeChecks" android:targetPackage="cn.yukina.online" android:label="MIGI Android 14 native checks"/>
    <instrumentation android:name="cn.migi.reader.RealStorageChecks" android:targetPackage="cn.yukina.online" android:label="Read-only real storage checks"/>
